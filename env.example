# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=scrum_automation

# Jira Configuration
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your-api-token

# Microsoft Teams Bot Configuration
TEAMS_APP_ID=your-teams-app-id
TEAMS_APP_PASSWORD=your-teams-app-password
TEAMS_TENANT_ID=your-tenant-id

# AWS Bedrock Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-bearer-token  # Alternative to access key/secret

# GitHub Configuration
GITHUB_TOKEN=your-github-token
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_REPO_OWNER=your-username-or-org
GITHUB_REPO_NAME=your-repo-name
GITHUB_REPO_PATH=/path/to/local/repo  # Optional: local path for repository
GITHUB_BASE_BRANCH=main

# LLM Configuration (Agentic Code Generation)
CURSOR_API_KEY=your-cursor-api-key  # Optional
CURSOR_API_URL=https://api.cursor.sh
AMAZON_Q_APP_ID=your-amazon-q-app-id  # Optional
LLM_PROVIDER_PRIORITY=bedrock,cursor,amazon_q
MAX_LLM_RETRIES=3
LLM_TIMEOUT_SECONDS=300

# Agentic Workflow Configuration
AGENTIC_ENABLED=True
AGENTIC_AUTO_CREATE_PR=False
AGENTIC_AUTO_MERGE=False
AGENTIC_BRANCH_PREFIX=feature
AGENTIC_MAX_ITERATIONS=5
AGENTIC_TEST_TIMEOUT=300

# Code Generation Configuration
CODEGEN_FOLLOW_STYLE=True
CODEGEN_ADD_TESTS=True
CODEGEN_RUN_TESTS=True
CODEGEN_VALIDATE_SYNTAX=True
CODEGEN_RUN_LINTERS=True

# Application Configuration
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development
DEBUG=True
